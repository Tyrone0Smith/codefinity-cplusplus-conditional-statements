#include <iostream>

double performOperation(int type, double a, double b) {
    switch (type) 
    {
        case 1: return a + b;
            std::cout << "Adding numbers" << std::endl;
        case 2: return a -b;
            std::cout << "Subtracting numbers" << std::endl;
        case 3: return a * b;
            std::cout << "Multipying numbers" << std::endl;
        case 4:
            if (b != 0)
                return a / b;
                std::cout << "Dividing numbers" << std::endl;
            {
                std::cout << "Error: Division by zero" << std::endl;
                return 0;
            }
            return 0;
        default:
            std::cout << "Invalid operation type" << std::endl;
            return 0;
    }
}

int main()
{
    double x = 12.0, y = 4.0;
    int op = 3; // 1-Add, 2-Subtract, 3-Multiply, 4-Divide
    std::cout << "Result: " << performOperation(op, x, y) << std::endl;
    return 0;
}